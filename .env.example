# Nexus - Environment Configuration
# Copy this to .env and fill in your values

# -- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change-me-to-something-random-in-production

# -- Ollama --------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Default model to use when none is specified
# Run `ollama list` to see your installed models
DEFAULT_MODEL=mistral

# Generation defaults
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# -- Memory --------------------------------------------------------------------
# Where to store the vector DB and all persistent data
DATA_DIR=~/.nexus

# ChromaDB collection name
MEMORY_COLLECTION=nexus_memory

# Sentence-transformers model for embeddings (downloads on first run, ~90MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Max memories to inject into context per request
MAX_MEMORY_RESULTS=5

# Minimum relevance score to include a memory (0.0 - 1.0)
MEMORY_RELEVANCE_THRESHOLD=0.25

# -- Web Search ----------------------------------------------------------------
# Searx - self-hosted privacy-respecting search
# Run: docker run -d -p 8080:8080 searxng/searxng
SEARX_URL=http://localhost:8080

# Brave Search API (optional, free tier: 2000 req/day)
# Get key at: https://api.search.brave.com
BRAVE_API_KEY=

# Jina Reader - extracts full article text from URLs
JINA_BASE_URL=https://r.jina.ai

# Max search results to retrieve
MAX_SEARCH_RESULTS=8

# Search timeout in seconds
SEARCH_TIMEOUT=10

# -- Research ------------------------------------------------------------------
DEFAULT_RESEARCH_DEPTH=15
MAX_RESEARCH_SOURCES=40

# -- Agents --------------------------------------------------------------------
MAX_AGENT_STEPS=20
AGENT_TIMEOUT=300

# -- Rate Limiting -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
