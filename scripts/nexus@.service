[Unit]
Description=Nexus Local LLM Interface
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/nexus/backend
ExecStart=/home/%i/nexus/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/%i/nexus/logs/nexus.log
StandardError=append:/home/%i/nexus/logs/nexus.log
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/%i/nexus/.env

[Install]
WantedBy=multi-user.target
